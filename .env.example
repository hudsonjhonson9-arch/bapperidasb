# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Koneksi PostgreSQL. Di Tillah lama n8n memakai database n8n_storage dengan
# user n8n_admin, dan tabel bapperida_* di sana sudah ada. Kalau memakai database
# baru, jalankan db/schema.sql lebih dulu.
DATABASE_URL=postgresql://n8n_admin:ganti_password@localhost:5432/n8n_storage

# Kunci penanda tangan cookie session. WAJIB diisi, minimal 16 karakter.
# Buat acak: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tanpa ini semua endpoint tulis /api akan dijawab 500 (gagal tertutup).
SESSION_SECRET=

# Akun admin pertama. Seed otomatis saat tabel bapperida_admin masih kosong.
# Setelah akun ada, env ini diabaikan — ubah PIN lewat halaman admin.
# PIN lama situs ini "2026" dan harus dianggap bocor: isi yang baru di sini.
ADMIN_USERNAME=admin
ADMIN_PIN=ganti-dengan-pin-acak-minimal-6-karakter
ADMIN_NAMA=Administrator BAPPERIDA

# ── Google Apps Script (upload file ke Drive) ────────────────────────────────
# URL web app dari Deploy → New deployment → Web app (Execute as: Me, Access: Anyone)
GAS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec

# Kunci yang sama diisi di Code.gs (var API_KEY). Mencegah GAS dipakai sebagai
# tempat sampah file anonim. Kosongkan hanya kalau GAS belum diisi kuncinya.
GAS_API_KEY=

# ── Email (form kontak, opsional) ────────────────────────────────────────────
# Kalau SMTP_HOST kosong, pesan tetap disimpan ke tabel bapperida_pesan dan
# bisa dibaca di halaman admin, tapi tidak ada email yang terkirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BAPPERIDA Sumba Barat <noreply@example.go.id>
MAIL_TO=kontak@example.go.id

# ── Client (Vite, wajib awalan VITE_) ───────────────────────────────────────
# URL GAS yang dipanggil browser untuk upload file.
VITE_GAS_WEBAPP_URL=https://script.google.com/macros/s/xxx/exec
VITE_GAS_API_KEY=

# Origin yang boleh memanggil API. Kosong = hanya same-origin (cocok untuk
# frontend dan server di domain yang sama). Jangan isi '*': wildcard +
# cookie session berarti situs mana pun bisa membaca respons API.
CORS_ORIGIN=